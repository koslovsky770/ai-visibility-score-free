# נדרש כדי שהניתוח הסמנטי (Claude) יעבוד. קבלו מפתח ב-https://console.anthropic.com
# העתיקו קובץ זה ל-.env.local (המוגדר כבר ב-.gitignore) והזינו את המפתח האמיתי.
ANTHROPIC_API_KEY=

# אופציונלי, אבל בלעדיו הגבלת השימוש (אימייל/דומיין/IP) והקאש כבויים לגמרי.
# חברו "Upstash for Redis" מתוך Vercel → הפרויקט → Storage, זה ממלא את שני
# המשתנים האלה אוטומטית. לפיתוח מקומי אפשר להעתיק אותם מ-Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
